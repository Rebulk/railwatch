#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "open3"
require "rubygems/package"
require "tmpdir"
require_relative "../railwatch_specification"

ROOT = File.expand_path("..", __dir__)
PUBLIC_NAME = Railwatch::Packaging::PUBLIC_NAME

def run!(*command, chdir:, env: {}, print_output: true)
  stdout, stderr, status = Open3.capture3(env, *command, chdir: chdir)
  output = [ stdout, stderr ].reject(&:empty?).join
  raise "#{command.join(' ')} failed:\n#{output}" unless status.success?

  puts output if print_output && !output.empty?
  stdout
end

def assert!(condition, message)
  raise message unless condition
end

def without_bundler
  environment = ENV.to_h
  ENV.each_key do |key|
    environment[key] = nil if key.start_with?("BUNDLE_", "BUNDLER_")
  end
  environment.merge("RUBYOPT" => nil, "RUBYLIB" => nil)
end

tmp = Dir.mktmpdir("railwatch-package-")
begin
  version = Railwatch::VERSION
  gem_file = File.join(tmp, "#{PUBLIC_NAME}-#{version}.gem")

  run!("gem", "build", "railwatch.gemspec", "--strict", "--output", gem_file, chdir: ROOT)

  package_spec = Gem::Package.new(gem_file).spec
  assert!(package_spec.name == PUBLIC_NAME, "public gem name is #{package_spec.name.inspect}")
  assert!(package_spec.version.to_s == version, "package version does not match Railwatch::VERSION")
  assert!(package_spec.authors == [ "Cole Robertson" ], "package author changed")
  assert!(package_spec.licenses == [ "MIT" ], "package must use the MIT license")
  assert!(package_spec.homepage == "https://railwatch.rebulk.com", "package homepage changed")
  assert!(package_spec.required_ruby_version == Gem::Requirement.new(">= 3.4"), "supported Ruby constraint changed")
  assert!(package_spec.metadata["rubygems_mfa_required"] == "true", "RubyGems MFA must be required")
  expected_source = "https://github.com/Rebulk/railwatch"
  assert!(package_spec.metadata["source_code_uri"] == expected_source, "source metadata changed")

  runtime_dependencies = package_spec.runtime_dependencies.to_h do |dependency|
    [ dependency.name, dependency.requirement ]
  end
  expected_dependencies = {
    "base64" => Gem::Requirement.new("~> 0.2"),
    "inertia_rails" => Gem::Requirement.new("~> 3.21"),
    "rails" => Gem::Requirement.new(">= 8.1", "< 9"),
    "tdigest" => Gem::Requirement.new("~> 0.2")
  }
  assert!(runtime_dependencies == expected_dependencies, "runtime dependencies changed: #{runtime_dependencies}")

  expected_files = %w[
    AGENTS.md
    CHANGELOG.md
    MIT-LICENSE
    README.md
    app/controllers/railwatch/beacon_controller.rb
    config/routes.rb
    docs/getting-started.md
    docs/security.md
    lib/generators/railwatch/install/install_generator.rb
    lib/generators/railwatch/install/templates/initializer.rb.tt
    lib/railwatch.rb
    lib/railwatch/version.rb
    lib/railwatch/wire_fixtures.json
    llms.txt
    app/controllers/railwatch/dashboard_controller.rb
    app/views/layouts/railwatch/dashboard.html.erb
    db/railwatch_migrate/20260916000000_create_railwatch_tables.rb
    db/railwatch_telemetry_migrate/20260903000001_create_telemetry.rb
    public/railwatch/manifest.json
    public/railwatch/icon.svg
  ]
  missing = expected_files - package_spec.files
  assert!(missing.empty?, "package is missing runtime/docs files: #{missing.join(', ')}")

  allowed = %r{\A(?:app/|config/|db/|lib/|docs/|public/railwatch/|README\.md\z|CHANGELOG\.md\z|MIT-LICENSE\z|llms\.txt\z|AGENTS\.md\z)}
  forbidden = package_spec.files.reject { |path| allowed.match?(path) }
  assert!(forbidden.empty?, "package contains files outside the allowlist: #{forbidden.sort.join(', ')}")
  explicitly_forbidden = package_spec.files.grep(%r{\A(?:\.github|bench|script|spec|tmp|node_modules)/|\.test\.tsx?\z|\Aapp/frontend/test-setup\.ts\z|\A(?:Gemfile\.lock|land\.sh|CLAUDE\.md|package\.json|pnpm-lock\.yaml|vite\.config\.ts)\z})
  # The dashboard ships built for hosts (no Node) and as source for Railwatch
  # Cloud's own build; frontend tests never ship.
  assert!(package_spec.files.include?(Railwatch::Packaging::BROWSER_CLIENT), "package is missing the browser client")
  frontend = package_spec.files.grep(%r{\Aapp/frontend/})
  %w[app/frontend/entrypoints/inertia.tsx app/frontend/entrypoints/application.css app/frontend/pages/overview/show.tsx].each do |path|
    assert!(frontend.include?(path), "package is missing frontend source #{path}")
  end
  entries = package_spec.files.grep(%r{\Apublic/railwatch/assets/.*\.js\z})
  assert!(entries.any?, "package has no built dashboard bundle; run rake dashboard:build")
  assert!(explicitly_forbidden.empty?, "package contains internal files: #{explicitly_forbidden.sort.join(', ')}")

  gem_home = File.join(tmp, "gem-home")
  run!("gem", "install", gem_file, "--local", "--ignore-dependencies", "--no-document", "--install-dir", gem_home,
       chdir: tmp, env: without_bundler)

  installed_root = File.join(gem_home, "gems", "#{PUBLIC_NAME}-#{version}")
  boot = <<~'RUBY'
    require "rubygems"
    gem ENV.fetch("PACKAGE_NAME"), ENV.fetch("PACKAGE_VERSION")
    require "railwatch"

    spec = Gem.loaded_specs.fetch(ENV.fetch("PACKAGE_NAME"))
    unless File.realpath(spec.full_gem_path) == File.realpath(ENV.fetch("INSTALLED_ROOT"))
      abort "wrong installed gem activated: #{spec.full_gem_path}"
    end
    abort "Railwatch::VERSION did not boot" unless Railwatch::VERSION == ENV.fetch("PACKAGE_VERSION")
    source_root = File.expand_path(ENV.fetch("SOURCE_ROOT"))
    leaked = $LOADED_FEATURES.any? { |path| File.expand_path(path).start_with?("#{source_root}/lib/railwatch") }
    abort "source checkout supplied Railwatch features" if leaked
  RUBY
  smoke_env = without_bundler.merge(
    "GEM_HOME" => gem_home,
    "GEM_PATH" => ([ gem_home ] + Gem.path).uniq.join(File::PATH_SEPARATOR),
    "INSTALLED_ROOT" => installed_root,
    "PACKAGE_NAME" => PUBLIC_NAME,
    "PACKAGE_VERSION" => version,
    "SOURCE_ROOT" => ROOT
  )
  run!(Gem.ruby, "-e", boot, chdir: tmp, env: smoke_env)

  puts "Verified #{PUBLIC_NAME} #{version} package."
ensure
  FileUtils.rm_rf(tmp)
end
